{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pnpm --filter web exec tsc --noEmit:*)",
      "Bash(pnpm --filter tarot-ai-api-sevice exec tsc --noEmit:*)",
      "Bash(pnpm --filter tarot-telegram-bot exec tsc --noEmit:*)",
      "Bash(pnpm --filter tarot-admin exec tsc --noEmit:*)",
      "Bash(pnpm --filter tarot-telegram-bot exec vitest run:*)",
      "Bash(pnpm --filter web sync:responsive-tokens)",
      "Bash(rg:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.pnpm-store/**)",
      "Read(**/dist/**)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)",
      "Read(**/tsconfig.tsbuildinfo)",
      "Read(apps/web/src/locales/*/card.json)",
      "Read(apps/web/public/locales/**)",
      "Read(apps/web/assets/images/videos/**)",
      "Read(apps/web/assets/fonts/**)",
      "Read(apps/web/public/videos/**)"
    ]
  }
}
