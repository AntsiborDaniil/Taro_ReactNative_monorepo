{
  "name": "tarot-ai-api-sevice",
  "version": "2.0.0",
  "description": "Mindful Tarot API — Supabase Auth, Postgres, OpenAI",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "start": "node dist/index.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "private": true,
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "nodemon": "^3.1.10",
    "openai": "^5.5.1",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2"
  },
  "resolutions": {
    "typescript": "5.8.3"
  }
}
