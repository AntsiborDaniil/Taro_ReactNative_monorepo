# Supabase (required in production; в dev с placeholder-ключами включается RAM-бэкенд)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Принудительно RAM-бэкенд без Supabase (auth, spreads, favorites, settings, daily limit)
# USE_MEMORY_BACKEND=1

# Заглушка OpenAI для локального UI (вкл. автоматически с memory, если нет реального ключа)
# USE_MOCK_OPENAI=1
# MOCK_OPENAI_DELAY_MS=3200

# Memory dev: 1 = регистрация с кодом (как prod); по умолчанию — сразу вход после signup
# DEV_AUTH_REQUIRE_EMAIL_VERIFY=1

# Логи auth HTTP в dev (по умолчанию вкл.; 0 — выкл.)
# LOG_AUTH_HTTP=0

# OpenAI (optional in memory+mock; required for live interpret)
# OPENAI_API_KEY=sk-...
# Модель для «Глубокого разбора» (⚡2). Пусто — та же модель, что у обычного расклада (gpt-4o-mini).
OPENAI_DEEP_MODEL=

# Server
PORT=3002
NODE_ENV=development
# Production: https://your-app.vercel.app (и кастомный домен, если есть)
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173

# Публичный URL веб-приложения (редирект после Google OAuth)
WEB_APP_URL=http://localhost:8081

# Публичный URL API для redirect_uri (локально совпадает с PORT)
API_PUBLIC_URL=http://127.0.0.1:3002

# Разрешить CORS для *.vercel.app (preview-деплои)
ALLOW_VERCEL_PREVIEW=1

# Limits
# Бесплатных AI-раскладов в сутки (сутки — UTC на сервере).
TAROT_DAILY_INTERPRET_LIMIT=1

# Lava.top — digital product packs (+N spread credits). Leave empty until configured.
# Один оффер (продукт Lava) на пакет, вебхук общий. Пакет без оффера не показывается.
# Цены витрины — apps/api/src/lib/creditPacks.ts (должны совпадать с кабинетом Lava).
# LAVA_API_KEY=
# LAVA_OFFER_ID=          # +3 заряда (129 ₽)
# LAVA_OFFER_ID_9=        # +9 зарядов (249 ₽), продукт 377dbdcd-c69a-49e5-bbdb-1b77ef23abca
# LAVA_OFFER_ID_15=       # +15 зарядов (379 ₽), продукт f4b7fdf1-61ac-448c-94a5-c7c3687fce25
# В env нужен id ОФФЕРА (не продукта): cd apps/api && node --env-file=.env scripts/lava-offers.mjs
# LAVA_WEBHOOK_SECRET=
# LAVA_API_BASE_URL=https://gate.lava.top
# LAVA_CREDITS_PER_PURCHASE=3

# Telegram Mini App auth + support ticket ingest/replies (same bot as apps/bot)
TELEGRAM_BOT_TOKEN=
# Optional pepper for derived Telegram user passwords (defaults to TELEGRAM_BOT_TOKEN)
# TELEGRAM_AUTH_SECRET=
# Dev: принять initData без HMAC / без токена (только non-production + memory)
# TELEGRAM_DEV_BYPASS=1
