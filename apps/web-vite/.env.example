# ─── Локальная разработка ────────────────────────────────────────────────────
# Хост браузера и прокси Vite должны совпадать (localhost, порт 5174).
# /api проксируется на API :3002, пока моки выключены.

# MSW вместо живого API. Включать только для обзора UI без бэкенда.
# VITE_USE_MOCKS=1

# Авто-вход: POST /api/auth/dev/quick-login (аналог EXPO_PUBLIC_DEV_QUICK_LOGIN).
# Нужен API с memory-бэкендом. С VITE_USE_MOCKS=1 ручка отвечает моком.
# VITE_DEV_QUICK_LOGIN=1

# ─── Vercel production ───────────────────────────────────────────────────────
# Сборка (scripts/generate-vercel-config.mjs) проксирует /api/* кроме /api/auth/*
# на TAROT_API_PROXY_URL. /api/auth/* — serverless этого пакета.
#
# TAROT_API_PROXY_URL=https://your-api.onrender.com
# WEB_APP_URL=https://your-app.vercel.app
# Юзернейм бота без @ — для t.me/?startapp= ссылок шаринга расклада.
# VITE_TELEGRAM_BOT_USERNAME=MindFullTaro_bot
