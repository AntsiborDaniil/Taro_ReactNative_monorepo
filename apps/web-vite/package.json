{
  "name": "web-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-vercel-config.mjs && node scripts/generate-legal-html.mjs && vite build && node scripts/inject-seo-html.mjs && pnpm --filter tarot-admin build && node scripts/copy-admin-dist.mjs",
