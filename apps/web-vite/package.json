    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.4.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "typescript": "~5.8.3",
    "vite": "^6.2.2",
