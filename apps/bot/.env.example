# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Production Mini App (web-vite on Vercel)
WEB_APP_URL=https://taro-react-native-monorepo-web-vite.vercel.app/

# Public API for support ticket ingest
API_PUBLIC_URL=https://taro-reactnative-monorepo.onrender.com

# HTTP health check for Timeweb (optional, default 8080)
PORT=8080

# One-shot after deploy: broadcast «free daily readings available» to all telegram users.
# Set to 1 once on Timeweb, redeploy/restart, then remove (API is idempotent via bot_notify_state).
# BROADCAST_DAILY_FREE_ONCE=1
