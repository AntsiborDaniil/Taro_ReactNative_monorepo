# ─── Local development ───────────────────────────────────────────────────────
# Use the SAME host as the browser URL (localhost vs 127.0.0.1) or cookies break.
EXPO_PUBLIC_TAROT_API_BASE_URL=http://localhost:3002

# Авто-вход demo@tarot.local через POST /api/auth/dev/quick-login (нужен memory API).
EXPO_PUBLIC_DEV_QUICK_LOGIN=1

# ─── Vercel production (рекомендуется) ───────────────────────────────────────
# Оставьте пустым или same-origin — запросы идут на тот же домен (/api → proxy).
# EXPO_PUBLIC_TAROT_API_BASE_URL=same-origin
#
# В Vercel Project Settings также задайте:
# TAROT_API_PROXY_URL=https://your-api.onrender.com
# WEB_APP_URL=https://your-app.vercel.app
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...  (serverless OAuth в apps/web/api/)
