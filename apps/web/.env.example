# ─── Local development ───────────────────────────────────────────────────────
# API на localhost (не смешивайте localhost и 127.0.0.1 — cookie не пройдут).
EXPO_PUBLIC_TAROT_API_BASE_URL=http://127.0.0.1:3002

# ─── Vercel production (рекомендуется) ───────────────────────────────────────
# Оставьте пустым или same-origin — запросы идут на тот же домен (/api → proxy).
# EXPO_PUBLIC_TAROT_API_BASE_URL=same-origin
#
# В Vercel Project Settings также задайте:
# TAROT_API_PROXY_URL=https://your-api.onrender.com
