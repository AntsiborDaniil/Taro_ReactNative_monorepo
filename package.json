{
  "name": "tarot-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter tarot-ai-api-sevice dev",
    "dev:bot": "pnpm --filter tarot-telegram-bot dev",
    "dev:ui": "sh -c 'trap \"kill 0\" EXIT INT TERM; pnpm run dev:ui:api & pnpm run dev:ui:web & wait'",
    "dev:ui:api": "NODE_ENV=development USE_MEMORY_BACKEND=1 USE_MOCK_OPENAI=1 TAROT_DAILY_INTERPRET_LIMIT=100000 pnpm --filter tarot-ai-api-sevice dev",
    "dev:ui:web": "EXPO_PUBLIC_DEV_QUICK_LOGIN=1 EXPO_PUBLIC_TAROT_API_BASE_URL=http://localhost:3002 pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter tarot-ai-api-sevice build",
    "dev:web-vite": "pnpm --filter web-vite dev",
    "build:web-vite": "pnpm --filter web-vite build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "deploy:check-health": "bash scripts/check-production-health.sh",
    "supabase:functions": "supabase functions serve --env-file apps/api/.env"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
